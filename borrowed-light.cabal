cabal-version:      2.4
name:               borrowed-light
version:            0.1.0.0
synopsis:           Time-shifting puzzle prototype with a time budget, crates and pits (Haskell GameJam practice).
license:            NONE
build-type:         Simple
extra-doc-files:    README.md

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -O2

-- The pure core. No graphics dependency, so `cabal test` needs no OpenGL/GLUT
-- and the rules cannot import Gloss by accident.
library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  Game.Types
                    Game.Level
                    Game.Logic
                    Game.Input
                    Game.Fx
                    Game.Solution
                    Game.Run
                    Game.Sound
                    Game.Story
  build-depends:    base >=4.18 && <5, containers >=0.6 && <0.8

executable borrowed-light
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  other-modules:    Audio
                    Draw
                    Figures
                    Font
                    Hud
                    Lobby
                    PixelFont
                    Platform
                    Portrait
                    Render
                    Save
                    Station
                    Synth
                    TalkBox
                    Title
                    Video
  build-depends:    base >=4.18 && <5, array, borrowed-light, bytestring, containers, directory, filepath, gloss ==1.13.*
  ghc-options:      "-with-rtsopts=-A32m"
  -- The sound mixer. It plays through winmm on Windows and is silent elsewhere.
  c-sources:        cbits/audio.c
  cc-options:       -O2
  if os(windows)
    extra-libraries: winmm
  -- The game runs no Haskell threads. On Windows it uses the single-threaded
  -- runtime, after two unexplained crashes in the threaded one while freeglut called
  -- back into Haskell; elsewhere it keeps the threaded runtime it was tested with.
  -- Either way GLFW runs on the main OS thread, as it requires.
  if !os(windows)
    ghc-options:    -threaded

test-suite spec
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:    base >=4.18 && <5, borrowed-light, containers

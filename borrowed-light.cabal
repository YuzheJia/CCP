cabal-version:      2.4
name:               borrowed-light
version:            0.1.0.0
synopsis:           Time-shifting puzzle prototype with a time budget, crates and pits (Haskell GameJam practice).
license:            NONE
build-type:         Simple
extra-doc-files:    README.md

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -O2

-- The pure core. No graphics dependency, so `cabal test` needs no OpenGL/GLUT
-- and the rules cannot import Gloss by accident.
library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  Game.Types
                    Game.Level
                    Game.Logic
                    Game.Input
                    Game.Fx
                    Game.Solution
                    Game.Run
                    Game.Sound
                    Game.Story
                    Game.Orders
  -- array (a GHC boot package, like containers) holds the dead-end search's
  -- unboxed tables, which the garbage collector neither copies nor reads.
  build-depends:    base >=4.18 && <5, array >=0.5 && <0.6, containers >=0.6 && <0.8

executable borrowed-light
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  other-modules:    Audio
                    Draw
                    Figures
                    Font
                    Hud
                    KeeperPortrait
                    Lobby
                    OrdersScreen
                    PixelFont
                    Platform
                    Portrait
                    Render
                    Save
                    Station
                    Synth
                    TalkBox
                    Title
                    Video
  build-depends:    base >=4.18 && <5, array, borrowed-light, bytestring, containers, directory, filepath, gloss ==1.13.*, time
  -- Runtime options. -A32m: a 32 MB nursery, so a frame's short-lived pictures are
  -- collected cheaply. -V0.005 -C0.005: the runtime may switch between Haskell
  -- threads every 5 ms rather than every 20. On the single-threaded runtime the
  -- thread making the ending's sounds (see Audio) takes turns with the game loop
  -- for the first few seconds, and a shorter turn keeps frames from waiting long.
  ghc-options:      "-with-rtsopts=-A32m -V0.005 -C0.005"
  -- The sound mixer, which plays through winmm on Windows and is silent elsewhere,
  -- and turning off input methods (imm32), which would take the letter keys.
  c-sources:        cbits/audio.c
                    cbits/ime.c
  cc-options:       -O2
  if os(windows)
    extra-libraries: winmm imm32
  -- The game runs one Haskell thread besides its main loop: Audio's, which makes
  -- the ending's sounds once, after startup. On Windows it uses the single-threaded
  -- runtime, after two unexplained crashes in the threaded one while freeglut called
  -- back into Haskell; elsewhere it keeps the threaded runtime it was tested with.
  -- Either way GLFW runs on the main OS thread, as it requires.
  if !os(windows)
    ghc-options:    -threaded

test-suite spec
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:    base >=4.18 && <5, borrowed-light, containers

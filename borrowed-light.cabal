cabal-version:      2.4
name:               borrowed-light
version:            0.1.0.0
synopsis:           Time-shifting puzzle prototype with a time budget, crates and pits (Haskell GameJam practice).
license:            NONE
build-type:         Simple
extra-doc-files:    README.md

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -O2

-- The pure core. No graphics dependency, so `cabal test` needs no OpenGL/GLUT
-- and the rules cannot import Gloss by accident.
library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  Game.Types
                    Game.Level
                    Game.Logic
                    Game.Input
                    Game.Fx
                    Game.Solution
                    Game.Run
  build-depends:    base >=4.18 && <5, containers >=0.6 && <0.8

executable borrowed-light
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  other-modules:    Draw
                    Figures
                    Font
                    Hud
                    Platform
                    Render
                    Station
                    Title
  build-depends:    base >=4.18 && <5, borrowed-light, containers, gloss ==1.13.*
  ghc-options:      -threaded "-with-rtsopts=-A32m"
  -- For the window's close button: see app/Platform.hs.
  if os(darwin)
    frameworks:     GLUT
    extra-libraries: objc

test-suite spec
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:    base >=4.18 && <5, borrowed-light, containers

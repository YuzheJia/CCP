{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "windows": {
    "options": {
      "env": {
        "Path": "C:\\ghcup\\bin;${env:Path}"
      }
    }
  },
  "tasks": [
    {
      "label": "Haskell: Build",
      "type": "process",
      "command": "cabal",
      "args": ["build", "all"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Haskell: Run game",
      "type": "process",
      "command": "cabal",
      "args": ["run", "borrowed-light"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Haskell: Run game (fullscreen)",
      "type": "process",
      "command": "cabal",
      "args": ["run", "borrowed-light", "--", "--fullscreen"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Haskell: Test",
      "type": "process",
      "command": "cabal",
      "args": ["test", "spec", "--test-show-details=direct"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Haskell: REPL (game logic)",
      "type": "process",
      "command": "cabal",
      "args": ["repl", "lib:borrowed-light"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true }
    }
  ]
}
